# LLM provider (OpenAI-compatible, e.g. gapgpt). Never commit the real .env file.
GAPGPT_API_KEY=your-key-here
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
# Comma-separated models: the first two race each other, the rest are fallbacks.
GAPGPT_MODEL=gpt-4o-mini,gemini-3-flash-preview,gpt-5-mini
# Optional local fallback served by Ollama.
OLLAMA_MODEL=
# Word-by-word streaming (1 = on, 0 = off). Off is usually faster with gapgpt.
GAPGPT_STREAM=0
# Race the first two cloud models and keep the faster answer (1 = on, 0 = off).
GAPGPT_RACE=1
# Optional extra TMDB movies. 0 = only the official challenge list.
USE_TMDB=0
